# ============================================================
# ChristNerve — Nginx
# Landing: christnerve.scholarnerve.com
# Churches: ch-*.scholarnerve.com  (does not steal ScholarNerve hosts)
# ============================================================

upstream christnerve_api {
    server 127.0.0.1:5001;
    keepalive 32;
}

# ---------- Landing + Super Admin ----------
server {
    listen 80;
    listen [::]:80;
    server_name christnerve.scholarnerve.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name christnerve.scholarnerve.com;

    # Managed / updated by certbot
    ssl_certificate     /etc/letsencrypt/live/christnerve.scholarnerve.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/christnerve.scholarnerve.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/christnerve/frontend/dist;
    index index.html;
    client_max_body_size 10M;

    location /uploads/ {
        alias /var/www/christnerve/uploads/;
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://christnerve_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location = /health {
        proxy_pass http://christnerve_api/health;
        access_log off;
    }

    location /socket.io/ {
        proxy_pass http://christnerve_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---------- Church tenants: ch-pka.scholarnerve.com, etc. ----------
# Regex is more specific than ScholarNerve's *.scholarnerve.com catch-all.
server {
    listen 80;
    listen [::]:80;
    server_name ~^ch-.+\.scholarnerve\.com$;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ~^ch-.+\.scholarnerve\.com$;

    # Prefer shared wildcard cert if available; else point to christnerve cert
    ssl_certificate     /etc/letsencrypt/live/scholarnerve.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scholarnerve.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/christnerve/frontend/dist;
    index index.html;
    client_max_body_size 10M;

    location /uploads/ {
        alias /var/www/christnerve/uploads/;
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://christnerve_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Critical — backend resolves tenant from Host (ch-{slug})
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location = /health {
        proxy_pass http://christnerve_api/health;
        access_log off;
    }

    location /socket.io/ {
        proxy_pass http://christnerve_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
